{
  "name": "evm-wallet-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "indexer:codegen": "python3 scripts/run_indexer.py codegen",
    "indexer:dev": "python3 scripts/run_indexer.py dev",
    "analytics:build": "python3 scripts/run_dbt.py build",
    "analytics:build:hyperindex": "python3 scripts/run_dbt.py build --vars '{\"use_fixture\": false}'",
    "labels:sync": "python3 scripts/sync_token_registry.py",
    "labels:enrich": "python3 scripts/enrich_token_metadata.py",
    "addresses:enrich": "python3 scripts/enrich_counterparty_types.py",
    "export:dashboard": "python3 scripts/export_dashboard.py",
    "dashboard:dev": "vite --host 127.0.0.1",
    "dashboard:build": "vite build",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit scripts/codex_review_gate.sh",
    "review:staged": "scripts/codex_review_gate.sh",
    "test": "bun run analytics:build && bun run test:labels && bun run export:dashboard && bun run test:js && python3 scripts/run_dbt.py test",
    "test:labels": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:js": "vitest run",
    "test:analytics": "python3 scripts/run_dbt.py test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "cytoscape": "^3.30.4",
    "lucide-react": "^1.24.0",
    "vite": "^8.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bun": "^1.1.14",
    "@types/cytoscape": "^3.21.8",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "envio": "^3.2.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "body-parser": "1.20.3",
    "cookie": "0.7.2",
    "esbuild": "0.28.1",
    "express": "4.21.2",
    "path-to-regexp": "0.1.13",
    "qs": "6.15.3",
    "send": "0.19.0",
    "serve-static": "1.16.2",
    "ws": "8.21.0"
  }
}
