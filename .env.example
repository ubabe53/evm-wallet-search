# Required by Envio HyperIndex local development as of November 2025.
ENVIO_API_TOKEN=

# Read-only Postgres URI used by dbt in live HyperIndex mode.
# Example only: replace every placeholder with the values used by your Envio instance.
DBT_ENV_SECRET_HYPERINDEX_POSTGRES_DSN=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Optional private Ethereum RPC. Token and address enrichment use the public fallback
# from config.yaml when this value and ethereum.rpc_url are both empty.
ETHEREUM_RPC_URL=

# Optional batched eth_getCode controls. The fallback confirmation buffer is
# used only when the configured endpoint does not support the "safe" block tag.
ACCOUNT_EVIDENCE_BATCH_SIZE=100
ACCOUNT_EVIDENCE_MAX_RETRIES=2
ACCOUNT_EVIDENCE_FALLBACK_CONFIRMATIONS=64
